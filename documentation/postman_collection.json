              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.environment.set('walletId', b.id);",
                  "pm.test('README body', () => pm.expect(b).to.deep.include({playerId: pm.environment.get('playerId'), version: 1}));",
                  "pm.test('balance', () => pm.expect(b.balance).to.eql({amount: '1000.00', currency: 'BRL'}));"
                ]
