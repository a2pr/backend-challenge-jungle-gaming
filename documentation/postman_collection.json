    {
      "name": "Wagering",
      "item": [
        {
          "name": "BET (first time)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('externalTransactionId', 'ext-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('idempotencyKey', 'key-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('betExternalTransactionId', pm.environment.get('externalTransactionId'));",
                  "const b = pm.response.json();",
                  "pm.environment.set('transactionId', b.transactionId);",
                  "pm.test('processed, not a replay', () => pm.expect(b).to.deep.include({status:'PROCESSED', idempotentReplay:false}));",
                  "pm.test('balance debited', () => pm.expect(b.balance).to.eql({amount:'975.00', currency:'BRL'}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wagering/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wagering",
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{externalTransactionId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": {\n    \"amount\": \"25.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
